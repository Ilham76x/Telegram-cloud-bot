# Salin file ini menjadi .env, lalu isi dengan nilai ASLI.
# JANGAN PERNAH upload file .env ke GitHub.
# File ini (.env.example) hanya berisi contoh, jadi aman di-upload.

# Token bot BARU khusus cloud ini, dari @BotFather.
# JANGAN pakai token Fr1day atau token bot jualan.
BOT_TOKEN=ISI_TOKEN_BOT_BARU_DISINI

# ID grup file (topik-forum), contoh: -1001234567890
CHAT_ID=ISI_ID_GRUP_DISINI

# Biasanya General = 1
GENERAL_TOPIC=1

# ID topik tujuan ASLI. Angka di bawah ini hanya contoh,
# ganti dengan ID topik di grupmu.
TOPIC_IMAGE=100
TOPIC_VIDEO=200
TOPIC_AUDIO=300
TOPIC_DOCUMENT=400

# true = file dipindah (disalin ke topik, lalu asli di General dihapus)
# false = asli tetap di General, hanya disalin ke topik
DELETE_ORIGINAL=true
